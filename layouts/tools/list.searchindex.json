{{- $tools := partial "tools/registry.html" . -}}
{{- $index := slice -}}
{{- range $tools -}}
  {{- $index = $index | append (dict
      "id" .id
      "name" .name
      "description" .description
      "category" .category
      "category_name" .category_name
      "keywords" .keywords
      "features" .features
      "use_cases" .use_cases
      "examples" .examples
      "url" .url
      "canonical_url" .canonical_url
      "markdown_url" .markdown_url) -}}
{{- end -}}
{{- $index | jsonify (dict "indent" "  ") -}}
